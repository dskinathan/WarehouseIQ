# Copy this file to apps/web/.env.local and apps/mobile/.env, filling in
# your own Supabase project's values (Project Settings -> API). Never
# commit the actual .env files or the service-role key anywhere in this
# repo — the service-role key belongs only in Supabase Edge Function
# secrets (see docs/api/API.md), never in a client app.

# apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# apps/mobile/.env
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
